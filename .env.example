# Copy to .env and fill the values before starting the service.
#
# Codex headless authentication. The recommended option for a remote server is
# a Codex access token from a ChatGPT Business or Enterprise workspace.
CODEX_ACCESS_TOKEN=

# Explicit model for this bot. This keeps Codex app/default-config changes from
# changing the model used by Feishu conversations.
CODEX_MODEL=gpt-5.5

# read-only: inspect only. workspace-write: normal coding. danger-full-access:
# disables the Codex sandbox and should only be used on an isolated host.
CODEX_SANDBOX=workspace-write

# Codex network access. This can also be changed per Feishu chat with /network.
CODEX_NETWORK_ACCESS=false

# Additional comma-separated Feishu open_id values allowed to DM the bot.
# The app owner is already written to .env.lark by npm run setup.
FEISHU_ALLOWED_OPEN_IDS=

# Comma-separated group chat_id values. Empty means group bot responses are disabled.
FEISHU_ALLOWED_CHAT_IDS=

MAX_CONCURRENT_RUNS=2
MAX_PROMPT_CHARS=12000
PORT=3000

{
  "name": "feishu-codex-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote Feishu bot powered by the Codex SDK.",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "setup": "tsx src/setup-app.ts",
    "setup:prod": "node dist/src/setup-app.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-isolation=none dist/test/*.test.js"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.74.0",
    "@openai/codex": "0.155.1",
    "@openai/codex-sdk": "0.155.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
